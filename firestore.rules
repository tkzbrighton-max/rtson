rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidInquiry(data) {
      return data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
             data.projectDetails is string && data.projectDetails.size() >= 1 && data.projectDetails.size() <= 5000 &&
             data.totalEstimate is number && data.totalEstimate >= 0;
    }

    function isValidReview(data) {
      return data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidSiteConfig(data) {
      return data is map;
    }

    function isValidPortfolioItem(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.category is string && data.imageUrl is string &&
             data.price is number;
    }

    function isValidShowcaseVideo(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.videoUrl is string;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test path
    match /test/{docId} {
      allow read: if true;
    }

    match /_connection_test/{docId} {
      allow read: if true;
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isSignedIn();
    }

    // Site Config (Hero background, site settings)
    match /site_config/{configId} {
      allow read: if true;
      allow write, create, update, delete: if true; // Allow admin updates
    }

    // Dynamic Portfolio Items
    match /portfolio_items/{itemId} {
      allow read: if true;
      allow write, create, update, delete: if true; // Allow admin content updates
    }

    // Dynamic Showcase Videos
    match /showcase_videos/{videoId} {
      allow read: if true;
      allow write, create, update, delete: if true; // Allow admin video updates
    }
  }
}
